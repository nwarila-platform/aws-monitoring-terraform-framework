{
  "Statement": [
    {
      "Action": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalARN": [
            "arn:aws:iam::<account-id>:role/OrganizationAccountAccessRole",
            "arn:aws:iam::<account-id>:role/aws-service-role/*"
          ]
        },
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "DenyEveryRegionThisEstateDoesNotWatch"
    }
  ],
  "Version": "2012-10-17"
}
