# Copy this file to backend.hcl, fill in real values, and pass it with
# terraform -chdir=terraform init -backend-config=backend.hcl.
#
# Only deployment-specific values belong here. `encrypt` and `use_lockfile` are set in
# backend.tf because they are invariants for every deployment, not per-deployment choices.
bucket = "REPLACE_ME-terraform"
key    = "nwarila-platform/aws-cloudwatch-framework/terraform.tfstate"
region = "us-east-1"
