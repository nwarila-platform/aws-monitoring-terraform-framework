# Copy this file to terraform.tfvars, or supply the same values from a runner repository, before
# planning. Deployment identity (repository, repository_id, commit_sha, run_id) is NOT set here:
# a runner passes it as command-line -var arguments, which outrank every value file.

# Exactly one of dev, test, or prod (lowercase).
environment = "dev"

# Who is emailed on every security group and IAM change. Each address must confirm the
# subscription SNS emails it before anything is delivered. A prod deployment requires at least one.
alert_emails = ["REPLACE_ME@example.com"]

# Optional; shown with their defaults. Create the CloudTrail trail the alerts depend on only in an
# account that has no trail: a second one bills every management event twice.
manage_trail = false

# Role names, or patterns using *, whose security-group changes are not emailed, typically
# automation that rewrites security groups on every run. Prefer one pattern for a naming
# convention, such as "example-org_*_runner", over a list of names that must track every new
# pipeline. Their IAM changes still alert. The default exempts nobody.
exempt_pipeline_roles = []
